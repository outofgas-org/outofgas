{
  "name": "@outofgas/hooks",
  "version": "0.1.8",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --platform=browser"
  },
  "devDependencies": {
    "@outofgas/abi": "^0.1.0",
    "@outofgas/contracts": "^0.1.0",
    "@outofgas/eslint-config": "*",
    "@outofgas/core": "*",
    "@outofgas/typescript-config": "*",
    "@turbo/gen": "^2.5.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "eslint": "^9.29.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "wagmi": "^2.15.6"
  }
}
