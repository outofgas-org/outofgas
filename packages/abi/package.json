{
  "name": "@outofgas/abi",
  "version": "0.1.3",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@outofgas/eslint-config": "*",
    "@outofgas/typescript-config": "*",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "tsup": "^8.3.6",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "decimal.js": "^10.5.0",
    "graphql-tag": "^2.12.6",
    "viem": "^2.23.5"
  }
}
